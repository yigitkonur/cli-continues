{
  "name": "continues",
  "version": "4.1.1",
  "description": "Never lose context. Resume any AI coding session across Claude Code, Codex, Copilot, Gemini CLI, Cursor, Amp, Cline, Roo Code, Kilo Code, Kiro, Crush, OpenCode, Droid & Antigravity.",
  "keywords": [
    "ai",
    "coding-assistant",
    "codex",
    "claude",
    "copilot",
    "gemini",
    "opencode",
    "droid",
    "factory",
    "session",
    "resume",
    "context",
    "cli",
    "developer-tools",
    "productivity",
    "rate-limit",
    "session-handoff",
    "context-switch",
    "cross-tool",
    "cursor"
  ],
  "homepage": "https://github.com/yigitkonur/cli-continues#readme",
  "bugs": {
    "url": "https://github.com/yigitkonur/cli-continues/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yigitkonur/cli-continues.git"
  },
  "license": "MIT",
  "author": "Yigit Konur",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "cont": "bin/continues.js",
    "continues": "bin/continues.js"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "postinstall": "echo '\n  continues v3.0.0 — Major refactor with typed schemas, library exports & Cursor support!\n  Run `continues list` to see all sessions.\n'",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "check": "pnpm lint && pnpm build",
    "link": "pnpm build && pnpm link --global",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "ora": "^9.4.1",
    "tsx": "4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6",
  "engines": {
    "node": ">=22.12.0"
  }
}
